{
    "name": "axiom/framework",
    "description": "Axiom PHP framework designed for simplicity and performance",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Cristian Dealmonte"
        }
    ],
    "autoload": {
        "psr-4": {
            "Axiom\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Axiom\\Tests\\": "tests/"
        }
    },
    "archive": {
        "exclude": [
            "tests/",
            ".github/",
            "*.md"
        ]
    }
    
}
